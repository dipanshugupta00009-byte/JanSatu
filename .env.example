# Copy this file to .env and fill in your real values.

# ---------- Database (PostgreSQL — works with Supabase, Railway Postgres,
# Render Postgres, or a local Postgres install) ----------
# Easiest: paste your Supabase project's connection string here (Supabase
# dashboard → Project Settings → Database → Connection string → URI).
DATABASE_URL=

# ...or, if you don't set DATABASE_URL, these individual variables are used
# instead (for a local Postgres install):
PGHOST=localhost
PGPORT=5432
PGDATABASE=jansatu
PGUSER=postgres
PGPASSWORD=postgres

# Force SSL on/off for the database connection. Leave blank — it's decided
# automatically (on for any non-localhost DATABASE_URL, which covers Supabase).
PGSSL=

PORT=3000

# ---------- AI features (optional) ----------
# Categorization + case summaries use Claude; duplicate-detection does not
# need this. Get a key at https://console.anthropic.com — leave blank to
# disable the two Claude-powered features gracefully (rest of the site works fine).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------- Security ----------
# Restrict which website is allowed to call this API from a browser.
# Leave blank during local development; set to your real deployed frontend
# URL once live (e.g. https://jharkhand-bridge.up.railway.app).
ALLOWED_ORIGIN=
